# ─── Mạng đang chạy ────────────────────────────────────────────────
# anvil = blockchain local trên máy bạn (mặc định, không cần ví/faucet)
# fuji  = Avalanche Fuji testnet thật (cần ví Core/MetaMask + AVAX test)
NEXT_PUBLIC_CHAIN=anvil

# ─── Địa chỉ contract ──────────────────────────────────────────────
# Dòng này được ghi tự động, đừng sửa tay:
#   npm run deploy:anvil            → deploy lên chain local
#   npm run set-contract 0x...      → trỏ vào contract đã deploy bằng Remix
#   npm run deploy:fuji             → deploy lên Fuji bằng private key
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── RPC của anvil (tuỳ chọn) ──────────────────────────────────────
# Chỉ cần khi cổng 8545 đã bị chiếm bởi tiến trình khác:
#   ANVIL_PORT=8546 npm run anvil
#   NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8546
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ─── Ví deploy ─────────────────────────────────────────────────────
# CHỈ cần khi dùng `npm run deploy:fuji`. Deploy bằng Remix (khuyến nghị khi
# demo) hoặc chạy anvil thì để TRỐNG — không có key nào nằm trên máy cả.
# ⚠️ Ví TESTNET riêng, KHÔNG dùng ví thật, KHÔNG commit file .env.local!
DEPLOYER_PRIVATE_KEY=

# ─── Thu thập KPI (tuỳ chọn) ───────────────────────────────────────
# URL Google Apps Script web app nhận form Bước 3. Bỏ trống thì form
# hiện nhưng không gửi đi đâu. Cách tạo: xem README mục "Thu thập KPI".
NEXT_PUBLIC_KPI_ENDPOINT=

# ─── WalletConnect (cần cho ví trên ĐIỆN THOẠI) ────────────────────
# Core mobile / MetaMask mobile không inject ví vào Safari/Chrome, chúng kết
# nối qua WalletConnect. Tạo project miễn phí tại https://dashboard.reown.com
# rồi dán Project ID vào đây. Bỏ trống thì nút WalletConnect không hiện.
NEXT_PUBLIC_WC_PROJECT_ID=
